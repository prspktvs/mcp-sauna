{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/prspktvs/mcp-sauna/blob/main/references/results.schema.json",
  "title": "mcp-sauna results v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "skill_version", "rules_version", "summary", "scorecard", "metrics", "findings", "not_tested", "run_details", "disclosures"],
  "properties": {
    "schema_version": {"const": 1},
    "skill_version": {"type": "string"},
    "rules_version": {"type": "string"},
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["overall_grade", "verdict", "top_fixes"],
      "properties": {
        "overall_grade": {"enum": ["A", "B", "C", "D", "F", "incomplete"]},
        "verdict": {"type": "string"},
        "top_fixes": {"type": "array", "maxItems": 3, "items": {"$ref": "#/$defs/fix"}}
      }
    },
    "scorecard": {
      "type": "object", "additionalProperties": false,
      "required": ["Tool design", "Context cost", "Responses", "Errors", "Safety"],
      "properties": {
        "Tool design": {"$ref": "#/$defs/dimension"},
        "Context cost": {"$ref": "#/$defs/dimension"},
        "Responses": {"$ref": "#/$defs/dimension"},
        "Errors": {"$ref": "#/$defs/dimension"},
        "Safety": {"$ref": "#/$defs/dimension"}
      }
    },
    "metrics": {
      "type": "object", "additionalProperties": false,
      "required": ["task_count", "attempted_tasks", "skipped_tasks", "successful_tasks", "task_success_rate", "average_tool_calls_per_task", "average_estimated_tokens_per_task", "tool_definition_bytes", "estimated_tool_definition_tokens", "unsafe_behaviors_found", "total_tool_calls", "token_estimate_method"],
      "properties": {
        "task_count": {"type": "integer", "minimum": 0},
        "attempted_tasks": {"type": "integer", "minimum": 0},
        "skipped_tasks": {"type": "integer", "minimum": 0},
        "successful_tasks": {"type": "integer", "minimum": 0},
        "task_success_rate": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "average_tool_calls_per_task": {"type": ["number", "null"], "minimum": 0},
        "average_estimated_tokens_per_task": {"type": ["number", "null"], "minimum": 0},
        "tool_definition_bytes": {"type": "integer", "minimum": 0},
        "estimated_tool_definition_tokens": {"type": "integer", "minimum": 0},
        "unsafe_behaviors_found": {"type": "integer", "minimum": 0},
        "total_tool_calls": {"type": "integer", "minimum": 0},
        "token_estimate_method": {"type": "string"}
      }
    },
    "findings": {"type": "array", "items": {"$ref": "#/$defs/finding"}},
    "not_tested": {"type": "array", "items": {"$ref": "#/$defs/skippedProbe"}},
    "run_details": {
      "type": "object", "additionalProperties": false,
      "required": ["environment", "agent", "model", "date", "skill_version", "rules_version", "target_label"],
      "properties": {
        "environment": {"enum": ["dev", "test", "staging"]},
        "agent": {"type": "string"}, "model": {"type": "string"},
        "date": {"type": "string", "format": "date"},
        "skill_version": {"type": "string"}, "rules_version": {"type": "string"}, "target_label": {"type": "string"}
      }
    },
    "disclosures": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "dimension": {
      "type": "object", "additionalProperties": false,
      "required": ["grade", "status", "finding_count", "incomplete_reasons"],
      "properties": {
        "grade": {"enum": ["A", "B", "C", "D", "F"]},
        "status": {"enum": ["complete", "incomplete"]},
        "finding_count": {"type": "integer", "minimum": 0},
        "incomplete_reasons": {"type": "array", "items": {"type": "string"}}
      }
    },
    "fix": {
      "type": "object", "additionalProperties": false,
      "required": ["rule_id", "tool", "fix"],
      "properties": {"rule_id": {"type": "string"}, "tool": {"type": ["string", "null"]}, "fix": {"type": "string"}}
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "rule_id", "severity", "tool", "evidence_call_ids", "summary", "why_it_matters", "fix"],
      "properties": {
        "id": {"type": "string"}, "rule_id": {"type": "string"},
        "severity": {"enum": ["Critical", "High", "Medium", "Low"]},
        "tool": {"type": ["string", "null"]},
        "evidence_call_ids": {"type": "array", "items": {"type": "string"}},
        "summary": {"type": "string"}, "why_it_matters": {"type": "string"}, "fix": {"type": "string"}
      }
    },
    "skippedProbe": {
      "type": "object", "additionalProperties": false,
      "required": ["probe_id", "reason"],
      "properties": {"probe_id": {"type": "string"}, "reason": {"type": "string"}}
    }
  }
}
